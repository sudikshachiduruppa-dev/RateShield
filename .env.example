# RateShield Production Environment Variables Template
# Provide these in your deployment platform (Docker, Railway, Render, AWS, etc.)

# Database configuration
SPRING_DATASOURCE_URL=jdbc:mysql://your-production-db-host:3306/rateshield
SPRING_DATASOURCE_USERNAME=rateshield_user
SPRING_DATASOURCE_PASSWORD=your_secure_db_password

# JWT secret (must be at least 256 bits / 32 characters long)
RATESHIELD_JWT_SECRET=your_at_least_256_bit_long_cryptographically_secure_secret_key
JWT_EXPIRATION_SECONDS=86400

# CORS allowed frontend origins (comma-separated for multiple)
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com

# Server port
PORT=8080

# Local development overrides template (copy to local.properties)
# Do not commit real production passwords to git
spring.datasource.url=jdbc:mysql://localhost:3306/rateshield
spring.datasource.username=root
spring.datasource.password=your_local_mysql_password
rateshield.jwt.secret=your_local_secret_at_least_256_bits_long_for_hmac_sha256
